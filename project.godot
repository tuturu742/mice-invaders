; Mice Invaders -- a scaffold.
;
; Minimal on purpose: no main scene yet. A delegated agent builds the pure rules first --
; formation layout, how the swarm marches and drops, how it speeds up -- then a scene that
; plays them, and sets `run/main_scene` once there is something to run.
;
; export_presets.cfg already has a "Web" preset (no thread support, so the build runs from
; any static file server), which is what turns a green branch into a playable preview:
;   godot --headless --export-release Web build/web/index.html

config_version=5

[application]

config/name="Mice Invaders"
run/main_scene="res://scenes/main.tscn"
config/description="Space Invaders, except the player is a cat and the invaders are mice."
config/features=PackedStringArray("4.3", "GL Compatibility")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
